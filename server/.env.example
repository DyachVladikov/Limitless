# Server-only URI from Supabase > Connect. Percent-encode the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_POOL_SIZE=3
# Optional PEM CA certificate (literal \n allowed).
DATABASE_CA_CERT=

# Run npm run hash-password; paste the entire scrypt:... result.
OWNER_PASSWORD_HASH=
# Two DIFFERENT random secrets, at least 32 bytes each.
SESSION_SECRET=
CRON_SECRET=

# Exact browser origins, comma-separated, without trailing slash.
APP_ORIGINS=http://localhost:5173,http://localhost:8080
# Same-site: lax. Cross-site HTTPS: none.
SESSION_COOKIE_SAMESITE=lax
